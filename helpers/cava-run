#!/usr/bin/env bash
# Capture Pithos's output monitor, falling back to the default speaker.
set -euo pipefail

playback_monitor() {
  local output_index output_name
  output_index=$(timeout 2 pactl -f json list sink-inputs 2>/dev/null |
    jq -r '[.[] | select(.properties["application.id"] == "io.github.Pithos"
      or ((.properties["application.name"] // "") | ascii_downcase) == "pithos")]
      | sort_by(.corked) | .[0].sink // empty' 2>/dev/null || true)
  if [[ "$output_index" =~ ^[0-9]+$ ]]; then
    output_name=$(timeout 2 pactl -f json list sinks 2>/dev/null |
      jq -r --argjson index "$output_index" '.[] | select(.index == $index) | .name' 2>/dev/null || true)
  else
    output_name=""
  fi
  if [[ -z "$output_name" ]]; then
    output_name=$(timeout 2 pactl get-default-sink 2>/dev/null || true)
  fi
  if [[ "$output_name" =~ ^[[:alnum:]_.:-]+$ ]]; then
    printf '%s.monitor\n' "$output_name"
  else
    printf 'auto\n'
  fi
}

case "${1:-}" in
  --monitor) playback_monitor; exit ;;
  --source) monitor="${2:-}" ;;
  "") monitor=$(playback_monitor) ;;
  *) printf 'Usage: %s [--monitor|--source MONITOR]\n' "$0" >&2; exit 2 ;;
esac
if [[ ! "$monitor" =~ ^[[:alnum:]_.:-]+\.monitor$ && "$monitor" != auto ]]; then
  printf 'Invalid audio monitor.\n' >&2
  exit 2
fi
[[ "$monitor" == auto ]] || export PULSE_SOURCE="$monitor"

# A copied user binary can depend on an older Arch library version.
cava_binary=/usr/bin/cava
if [[ ! -x "$cava_binary" ]]; then
  cava_binary=$(command -v cava) || { printf 'Cava is not installed.\n' >&2; exit 127; }
fi

# The config goes to cava through a pipe, so no file is written: nothing is
# left behind however the shell stops the visualizer. This cava is started
# here and is the only one this script (or the shell) ever stops; a cava the
# user runs elsewhere is never touched.
config() {
  cat <<EOF
[general]
framerate = 60
bars = 56
autosens = 1
sensitivity = 160
lower_cutoff_freq = 30
higher_cutoff_freq = 14000

[input]
method = pulse
source = ${monitor}

[output]
method = raw
raw_target = /dev/stdout
data_format = ascii
ascii_max_range = 100
channels = mono
reverse = 0

[smoothing]
monstercat = 0
waves = 0
gravity = 80
noise_reduction = 22
EOF
}

exec stdbuf -oL "$cava_binary" -p <(config)

#!/usr/bin/env bash
# Developer install: copy this repo's plugin payload into the live Omarchy
# plugin folder. Does not touch ~/.config/omarchy/omapandora-pins.json.
#
# A normal install replaces only an unchanged managed copy.
# The marker .omapandora-dev-install lists every
# installed file with its SHA-256. If the folder has a file that is not on
# that list, or a listed file was changed, it stops and changes nothing.
# Recovery keeps an unmarked Micro-Pandora copy intact in a backup.
# Git checkouts are managed by Omarchy and are never replaced here.
set -euo pipefail

ID="io.github.micro23.micro-pandora"
MARKER=".omapandora-dev-install"
ROOT="$(realpath -- "$1")"
EXPECTED_VERSION="${2:-}"
RECOVER="${3:-}"
UI="$(dirname "$(jq -er '.entryPoints.panel' "$ROOT/manifest.json")")"
UI_PATTERN='qml(-[0-9]+(\.[0-9]+){2})?'
if [[ ! "$UI" =~ ^${UI_PATTERN}$ ]]; then
  echo "Invalid QML directory in manifest: $UI" >&2
  exit 1
fi
PLUGINS="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins"
DEST="$PLUGINS/$ID"

refuse() {
  echo "Not installing: $1" >&2
  shift
  for line in "$@"; do echo "  $line" >&2; done
  echo "Nothing was changed. Move your own files out of $DEST," >&2
  echo "or remove the plugin first: omarchy plugin remove $ID" >&2
  exit 1
}

# Files the marker says this script installed: listed[relative path]=sha256.
declare -A listed=() listed_dirs=()
keep_previous=false

read_marker() {
  local line hash rel
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    hash="${line%%  *}"
    rel="${line#*  }"
    if [[ ! "$hash" =~ ^[0-9a-f]{64}$ ]] \
      || [[ ! "$rel" =~ ^(manifest\.json|(${UI_PATTERN}|helpers)/[A-Za-z0-9._-]+)$ ]]; then
      refuse "$DEST/$MARKER is not a file list written by this script."
    fi
    listed["$rel"]="$hash"
    if [[ "$rel" == */* ]]; then listed_dirs["${rel%%/*}"]=1; fi
  done < "$DEST/$MARKER"
  [ "${#listed[@]}" -gt 0 ] || refuse "$DEST/$MARKER lists no files."
}

# Succeeds only if every entry in DEST is the marker, a listed parent
# directory, or a listed file that is byte-for-byte what was installed.
check_dest() {
  local problems=() path rel sum
  while IFS= read -r -d '' path; do
    rel="${path#"$DEST"/}"
    [[ "$rel" != "$MARKER" ]] || continue
    if [[ -n "${listed_dirs[$rel]+set}" ]]; then
      if [ -L "$path" ] || [ ! -d "$path" ]; then
        problems+=("$rel (not a plain folder)")
      fi
      continue
    fi
    if [ -L "$path" ] || [ ! -f "$path" ]; then
      problems+=("$rel (not a regular file)")
    elif [ -z "${listed[$rel]+set}" ]; then
      problems+=("$rel (not installed by this script)")
    else
      sum="$(sha256sum -- "$path")"
      [ "${sum%% *}" = "${listed[$rel]}" ] || problems+=("$rel (changed since it was installed)")
    fi
  done < <(find "$DEST" -mindepth 1 -print0)
  if [ "${#problems[@]}" -gt 0 ]; then
    refuse "$DEST has files this script did not install or has changed:" "${problems[@]}"
  fi
}

mkdir -p "$PLUGINS"
if [ -L "$PLUGINS" ]; then
  echo "Not installing: $PLUGINS is a symlink" >&2
  exit 1
fi

# Serialize validation and replacement with other Micro-Pandora installers.
exec 9<"$PLUGINS"
flock -w 10 9 || refuse "Another plugin install or update is running."

if [ -e "$DEST" ] || [ -L "$DEST" ]; then
  [ -L "$DEST" ] && refuse "$DEST is a symlink."
  [ -d "$DEST" ] || refuse "$DEST is not a folder."
  [ -O "$DEST" ] || refuse "$DEST is not owned by you."
  if [[ -n "$EXPECTED_VERSION" ]] &&
     { [ ! -f "$DEST/manifest.json" ] || [ -L "$DEST/manifest.json" ] ||
       [[ "$(jq -r '.version' "$DEST/manifest.json")" != "$EXPECTED_VERSION" ]]; }; then
    refuse "The installed version changed. Check for updates again."
  fi
  { [ -e "$DEST/.git" ] || [ -L "$DEST/.git" ]; } && refuse "$DEST is a git checkout (installed by omarchy plugin add)."
  if [ -L "$DEST/$MARKER" ]; then
    refuse "$DEST/$MARKER is a symlink."
  elif [ -f "$DEST/$MARKER" ]; then
    read_marker
    check_dest
  elif [ ! -e "$DEST/$MARKER" ] && [[ "$RECOVER" =~ ^(--recover-synced-install|--clean)$ ]] &&
       [ -f "$DEST/manifest.json" ] && [ ! -L "$DEST/manifest.json" ] &&
       jq -e --arg id "$ID" '.id == $id and (.version | strings | test("^[0-9]+[.][0-9]+[.][0-9]+$"))' \
         "$DEST/manifest.json" >/dev/null; then
    if [[ "$RECOVER" == "--recover-synced-install" ]]; then
      keep_previous=true
    fi
  elif [ -e "$DEST/$MARKER" ]; then
    refuse "$DEST/$MARKER is not a regular file."
  else
    refuse "The install record is missing. If Config Sync restored this copy," \
      "run ./scripts/install.sh --recover-synced-install from the latest release."
  fi
elif [[ -n "$EXPECTED_VERSION" ]]; then
  refuse "The installed version changed. Check for updates again."
fi

# Build the new copy next to the old one, then swap it in, so a failed
# copy never leaves a half-written plugin behind.
STAGE="$(mktemp -d "$PLUGINS/.$ID.new.XXXXXX")"
trap 'rm -rf -- "$STAGE"' EXIT
mkdir "$STAGE/$UI" "$STAGE/helpers"
cp "$ROOT/manifest.json" "$STAGE/manifest.json"
cp "$ROOT/$UI/"* "$STAGE/$UI/"
cp "$ROOT/helpers/"* "$STAGE/helpers/"
chmod +x "$STAGE/helpers/pithosctl" "$STAGE/helpers/cava-run" "$STAGE/helpers/setup-deps"
{
  echo "# Created by Micro-Pandora scripts/install.sh. It replaces this folder only"
  echo "# while it holds exactly these files, unchanged."
  (cd "$STAGE" && find manifest.json "$UI" helpers -type f -print0 | sort -z | xargs -0 sha256sum)
} > "$STAGE/$MARKER"
chmod 755 "$STAGE"

if [ -d "$DEST" ]; then
  OLD="$(mktemp -d "$PLUGINS/.$ID.old.XXXXXX")"
  mv -T "$DEST" "$OLD/plugin"
  if ! mv -T "$STAGE" "$DEST"; then
    mv -T "$OLD/plugin" "$DEST"
    rmdir "$OLD"
    exit 1
  fi
  trap - EXIT
  if $keep_previous; then
    echo "Kept the previous copy at $OLD/plugin"
    echo "Installed to $DEST"
    rm -rf "${XDG_CACHE_HOME:-$HOME/.cache}/quickshell/qmlcache"
    exit 0
  fi
  if [[ "$RECOVER" == "--clean" ]]; then
    rm -rf -- "$OLD"
  else
    # The old copy was checked above to hold only the listed, unchanged files.
    # Remove exactly those, then the empty folders. Anything that appeared
    # since the check makes rmdir fail, and the old copy is kept.
    for rel in "${!listed[@]}"; do
      rm -f -- "$OLD/plugin/$rel"
    done
    rm -f -- "$OLD/plugin/$MARKER"
    for dir in "${!listed_dirs[@]}"; do
      [ -d "$OLD/plugin/$dir" ] && { rmdir -- "$OLD/plugin/$dir" 2>/dev/null || true; }
    done
    if ! rmdir -- "$OLD/plugin" "$OLD" 2>/dev/null; then
      echo "Kept the previous copy at $OLD/plugin: it had new files in it." >&2
    fi
  fi
else
  mv -T "$STAGE" "$DEST"
  trap - EXIT
fi

# Clean up quickshell QML cache so it stops loading cached bytecode
rm -rf "${XDG_CACHE_HOME:-$HOME/.cache}/quickshell/qmlcache"

# Clean legacy Dankestrick plugin folder if present
if [ -d "$PLUGINS/io.github.dankestrick.omapandora" ]; then
  rm -rf "$PLUGINS/io.github.dankestrick.omapandora"
fi

echo "Installed to $DEST"
echo "If the keepLoaded service looks stale: omarchy restart shell"
